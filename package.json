{
  "name": "vue3-okr-tree",
  "version": "1.2.0",
  "description": "Vue 3 组织架构树 / OKR 树组件，支持根节点左右双向展开（vue-okr-tree 的 Vue 3 版本）",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "baiwumm"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-tree",
    "org-tree",
    "okr",
    "okr-tree",
    "org-chart",
    "tree",
    "vue-okr-tree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baiwumm/vue3-okr-tree"
  },
  "bugs": {
    "url": "https://github.com/baiwumm/vue3-okr-tree/issues"
  },
  "homepage": "https://github.com/baiwumm/vue3-okr-tree#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/vue3-okr-tree.cjs",
  "module": "./dist/vue3-okr-tree.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue3-okr-tree.umd.js",
  "jsdelivr": "./dist/vue3-okr-tree.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-okr-tree.es.js",
      "require": "./dist/vue3-okr-tree.cjs",
      "default": "./dist/vue3-okr-tree.es.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build:check": "pnpm build && pnpm verify:dist",
    "build:playground": "vite build --config vite.playground.config.ts",
    "preview:playground": "vite preview --config vite.playground.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^24.13.5",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "prismjs": "^1.30.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
